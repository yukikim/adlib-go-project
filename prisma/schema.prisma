datasource db {
  provider = "postgresql" // 必要に応じて変更
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Participant {
  id        String   @id @default(uuid())
  name      String
  instrument Instrument

  requestedSongs ParticipantSongRequest[]
  drumSessions   SessionSet[]        @relation("DrumSessions")
  bassSessions   SessionSet[]        @relation("BassSessions")
  pianoSessions  SessionSet[]        @relation("PianoSessions")
  sessionMembers SessionSetMember[]
}

model Song {
  id    String  @id @default(uuid())
  title String  @unique

  requests             ParticipantSongRequest[]
  sessionEntryRequests SessionEntryRequest[]
  sessionSets          SessionSet[]
}

model ParticipantSongRequest {
  id             String       @id @default(uuid())
  participant    Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId  String
  song           Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId         String
  keyName        String?      // vocal の場合のみ必須（アプリ側でバリデーション）
  round          Int          // 1 or 2（アプリ側でバリデーション）

  @@unique([participantId, songId])
}

model SessionSet {
  id             String        @id @default(uuid())
  sessionEvent   SessionEvent? @relation(fields: [sessionEventId], references: [id], onDelete: SetNull)
  sessionEventId String?
  title          String
  song           Song          @relation(fields: [songId], references: [id])
  songId         String
  setOrder       Int?
  isPublished    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  drum           Participant?  @relation("DrumSessions", fields: [drumId], references: [id])
  drumId         String?
  bass           Participant?  @relation("BassSessions", fields: [bassId], references: [id])
  bassId         String?
  piano          Participant?  @relation("PianoSessions", fields: [pianoId], references: [id])
  pianoId        String?

  keyName        String?

  members        SessionSetMember[]
  ratings        SessionSetRating[]
}

model SessionSetMember {
  id             String      @id @default(uuid())
  sessionSet     SessionSet  @relation(fields: [sessionSetId], references: [id], onDelete: Cascade)
  sessionSetId   String
  participant    Participant @relation(fields: [participantId], references: [id])
  participantId  String
  role           MemberRole

  @@unique([sessionSetId, participantId, role])
}

model UserAccount {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  role              UserRole           @default(member)
  status            AccountStatus      @default(active)
  lastSignedInAt    DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  memberProfile     MemberProfile?
  authSessions      AuthSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessionRatings    SessionSetRating[]
  sessionArchives   SessionArchive[]   @relation("ArchiveCreator")
  adminAuditLogs    AdminAuditLog[]
  announcements     Announcement[]     @relation("AnnouncementCreator")
  mailLogs          MailLog[]          @relation("MailLogCreator")
  columns           Column[]           @relation("ColumnAuthor")
}

model MemberProfile {
  id                String             @id @default(uuid())
  userAccount       UserAccount        @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  userAccountId     String             @unique
  displayName       String
  nickname          String?
  mainInstrument    Instrument
  subInstrument     String?
  gender            String?
  ageRange          String?
  area              String?
  bio               String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sessionEntries    SessionEntry[]
}

model SessionEvent {
  id                String               @id @default(uuid())
  title             String
  description       String?
  venue             String
  eventDate         DateTime
  startTime         DateTime?
  endTime           DateTime?
  round1StartAt     DateTime?
  round1EndAt       DateTime?
  round2StartAt     DateTime?
  round2EndAt       DateTime?
  status            SessionEventStatus   @default(draft)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  sessionEntries    SessionEntry[]
  sessionSets       SessionSet[]
  sessionRatings    SessionSetRating[]
  sessionArchives   SessionArchive[]
}

model SessionEntry {
  id                String             @id @default(uuid())
  sessionEvent      SessionEvent       @relation(fields: [sessionEventId], references: [id], onDelete: Cascade)
  sessionEventId    String
  memberProfile     MemberProfile      @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  memberProfileId   String
  attendanceStatus  AttendanceStatus   @default(attending)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  requests          SessionEntryRequest[]

  @@unique([sessionEventId, memberProfileId])
}

model SessionEntryRequest {
  id                String         @id @default(uuid())
  sessionEntry      SessionEntry   @relation(fields: [sessionEntryId], references: [id], onDelete: Cascade)
  sessionEntryId    String
  song              Song?          @relation(fields: [songId], references: [id], onDelete: SetNull)
  songId            String?
  songTitleSnapshot String
  keyName           String?
  round             Int
  priority          Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model SessionSetRating {
  id                String         @id @default(uuid())
  sessionEvent      SessionEvent   @relation(fields: [sessionEventId], references: [id], onDelete: Cascade)
  sessionEventId    String
  sessionSet        SessionSet     @relation(fields: [sessionSetId], references: [id], onDelete: Cascade)
  sessionSetId      String
  userAccount       UserAccount    @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  userAccountId     String
  rating            Int
  comment           String?
  ratedAt           DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([sessionSetId, userAccountId])
}

model SessionArchive {
  id                String                      @id @default(uuid())
  sessionEvent      SessionEvent                @relation(fields: [sessionEventId], references: [id], onDelete: Cascade)
  sessionEventId    String
  version           Int
  title             String
  eventDate         DateTime
  venue             String
  participantCount  Int
  note              String?
  deletedAt         DateTime?
  createdBy         UserAccount                 @relation("ArchiveCreator", fields: [createdById], references: [id])
  createdById       String
  createdAt         DateTime                    @default(now())

  participants      SessionArchiveParticipant[]
  sets              SessionArchiveSet[]
  auditLogs         AdminAuditLog[]

  @@unique([sessionEventId, version])
}

model SessionArchiveParticipant {
  id                String          @id @default(uuid())
  sessionArchive    SessionArchive  @relation(fields: [sessionArchiveId], references: [id], onDelete: Cascade)
  sessionArchiveId  String
  displayName       String
  mainInstrument    Instrument?
}

model SessionArchiveSet {
  id                  String                       @id @default(uuid())
  sessionArchive      SessionArchive               @relation(fields: [sessionArchiveId], references: [id], onDelete: Cascade)
  sessionArchiveId    String
  songTitle           String
  setOrder            Int?
  drumName            String?
  bassName            String?
  pianoName           String?
  frontSnapshot       Json?
  vocalSnapshot       Json?
  keyName             String?

  ratingSummary       SessionArchiveRatingSummary?
}

model SessionArchiveRatingSummary {
  id                  String             @id @default(uuid())
  sessionArchiveSet   SessionArchiveSet  @relation(fields: [sessionArchiveSetId], references: [id], onDelete: Cascade)
  sessionArchiveSetId String             @unique
  ratingCount         Int                @default(0)
  averageRating       Float?
  minRating           Int?
  maxRating           Int?
  distributionJson    Json?
}

model AdminAuditLog {
  id                String           @id @default(uuid())
  action            AuditAction
  targetType        String
  targetId          String?
  summary           String?
  payload           Json?
  performedBy       UserAccount      @relation(fields: [performedById], references: [id], onDelete: Cascade)
  performedById     String
  sessionArchive    SessionArchive?  @relation(fields: [sessionArchiveId], references: [id], onDelete: SetNull)
  sessionArchiveId  String?
  performedAt       DateTime         @default(now())
}

model AuthSession {
  id               String       @id @default(uuid())
  userAccount      UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  userAccountId    String
  sessionTokenHash String       @unique
  expiresAt        DateTime
  lastAccessedAt   DateTime     @default(now())
  createdAt        DateTime     @default(now())
}

model PasswordResetToken {
  id               String       @id @default(uuid())
  userAccount      UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  userAccountId    String
  tokenHash        String       @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime     @default(now())
}

model EmailVerificationToken {
  id               String       @id @default(uuid())
  userAccount      UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  userAccountId    String
  tokenHash        String       @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime     @default(now())
}

model Announcement {
  id               String       @id @default(uuid())
  title            String
  body             String
  isPublished      Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        UserAccount  @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById      String
}

model MailLog {
  id               String         @id @default(uuid())
  mailType         String
  toAddress        String
  subject          String
  bodySummary      String?
  status           MailLogStatus
  errorMessage     String?
  createdAt        DateTime       @default(now())
  sentAt           DateTime?
  createdBy        UserAccount?   @relation("MailLogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
}

model Column {
  id               String       @id @default(uuid())
  slug             String       @unique
  title            String
  summary          String
  body             String
  thumbnailLabel   String?
  authorName       String
  displayOrder     Int          @default(0)
  isPublished      Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        UserAccount? @relation("ColumnAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
}

enum Instrument {
  drum
  bass
  piano
  front
  vocal
}

enum MemberRole {
  front
  vocal
}

enum UserRole {
  member
  admin
}

enum AccountStatus {
  active
  suspended
  invited
}

enum AttendanceStatus {
  attending
  absent
  undecided
}

enum SessionEventStatus {
  draft
  recruiting_round1
  recruiting_round2
  generating
  published
  closed
}

enum AuditAction {
  archive_created
  archive_deleted
  session_rating_deleted
}

enum MailLogStatus {
  pending
  sent
  failed
}
